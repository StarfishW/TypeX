{
  "name": "typex",
  "productName": "TypeX",
  "version": "0.1.1",
  "description": "A free, seamless live-preview Markdown editor.",
  "author": "TypeX contributors",
  "license": "MIT",
  "homepage": "https://github.com/StarfishW/TypeX",
  "repository": {
    "type": "git",
    "url": "https://github.com/StarfishW/TypeX.git"
  },
  "bugs": {
    "url": "https://github.com/StarfishW/TypeX/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/smoke.mjs && node scripts/e2e.mjs && node scripts/e2e-lifecycle.mjs",
    "icon": "node scripts/make-icon.mjs",
    "licenses": "node scripts/licenses.mjs",
    "pack": "node scripts/licenses.mjs && electron-vite build && electron-builder --dir --publish never",
    "dist": "node scripts/licenses.mjs && electron-vite build && electron-builder --publish never",
    "dist:win": "node scripts/licenses.mjs && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "node scripts/licenses.mjs && electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "node scripts/licenses.mjs && electron-vite build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "app.typex.editor",
    "productName": "TypeX",
    "copyright": "Copyright © 2026 TypeX contributors",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/THIRD_PARTY_LICENSES.txt",
        "to": "THIRD_PARTY_LICENSES.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "zh_TW",
        "ja_JP",
        "ko_KR",
        "de_DE",
        "fr_FR",
        "es_ES",
        "pt_BR",
        "ru_RU"
      ],
      "include": "build/installer.nsh",
      "artifactName": "${productName}-${version}-win-setup.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icons",
      "category": "Office",
      "synopsis": "Markdown editor with seamless live preview",
      "mimeTypes": [
        "text/markdown",
        "text/x-markdown"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Default"
      }
    ]
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/turndown": "^5.0.6",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "gemoji": "^8.1.0",
    "markdown-it": "^15.0.3",
    "mathjax-full": "^3.2.1",
    "mermaid": "^12.3.0",
    "playwright-core": "^1.65.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
